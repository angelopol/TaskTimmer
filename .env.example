# Neon PostgreSQL (Vercel Marketplace / Neon Connect)
# Use the pooled URL for application requests and the direct URL for Prisma migrations/imports.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB?sslmode=require"

NEXTAUTH_SECRET="replace_with_a_random_secret"
NEXTAUTH_URL="http://localhost:3000"
SHORT_SESSION_HOURS=6
LONG_SESSION_DAYS=30
DEMO_SEED=false

# IdeaMap (Idealo) integration. The callback NEXTAUTH_URL + /api/integrations/ideamap/callback
# must be listed in IdeaMap's TASKTIMMER_REDIRECT_URIS.
IDEAMAP_API_URL="https://apiideapanel.idealo.com.ve/api-map"
IDEAMAP_WEB_URL="https://idealo.com.ve/idea-map"
# Optional: key for encrypting stored integration tokens (defaults to NEXTAUTH_SECRET).
INTEGRATIONS_SECRET=""
