generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TimeLogSource {
  PLANNED
  ADHOC
  MAKEUP
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  passwordHash  String
  activities    Activity[]
  segments      ScheduleSegment[]
  logs          TimeLog[]
  integrationTokens IntegrationToken[]
  externalReminders ExternalReminder[]
  ideamapConnection IdeaMapConnection?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Activity {
  id                  String            @id @default(cuid())
  user                User              @relation(fields: [userId], references: [id])
  userId              String
  name                String
  color               String?           // hex color
  weeklyTargetMinutes Int               @default(0)
  active              Boolean           @default(true)
  segments            ScheduleSegment[]
  logs                TimeLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  @@index([userId, name])
  @@unique([userId, name], name: "userId_name")
}

model ScheduleSegment {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  activity       Activity? @relation(fields: [activityId], references: [id])
  activityId     String?
  weekday        Int       // 1=Monday .. 7=Sunday
  startMinute    Int
  endMinute      Int
  notes          String?
  logs           TimeLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Validity range for historical snapshotting (week-based interpretation)
  effectiveFrom  DateTime  @default(now()) // interpreted as Monday (start of validity)
  effectiveTo    DateTime? // null => open-ended
  @@index([userId, weekday])
  @@index([userId, effectiveFrom, effectiveTo])
}

model TimeLog {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id])
  userId           String
  activity         Activity?       @relation(fields: [activityId], references: [id])
  activityId       String?
  segment          ScheduleSegment? @relation(fields: [segmentId], references: [id])
  segmentId        String?
  date             DateTime        // store the day (strip time in app logic)
  startedAt        DateTime
  endedAt          DateTime?       // null => ongoing (active) log
  minutes          Int             // can be 0 while ongoing; finalized on termination
  partial          Boolean         @default(false)
  source           TimeLogSource   @default(PLANNED)
  comment          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([userId, date])
  @@index([activityId])
}

// Personal token used by the iOS Shortcut to push Apple Reminders. Only the SHA-256 hash is stored.
model IntegrationToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       String    @default("apple-reminders")
  tokenHash  String    @unique
  prefix     String    // first characters, shown in the UI to identify the token
  lastUsedAt DateTime?
  lastSyncAt DateTime? // last successful reminders upload (even when it had 0 pending)
  createdAt  DateTime  @default(now())
  @@unique([userId, kind])
}

// Read-only copy of the user's pending Apple Reminders. Syncs are deduplicated by `externalKey`:
// new reminders are created, known ones updated, and ones no longer sent (completed/deleted) removed.
model ExternalReminder {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  source    String    @default("apple")
  externalKey String  // sha256 of title + list + creation date: stable identity across syncs
  title     String
  notes     String?
  list      String?
  dueAt     DateTime?
  allDay    Boolean   @default(false)
  completed Boolean   @default(false)
  flagged   Boolean   @default(false)
  priority  Int       @default(0)
  syncedAt  DateTime  @default(now())
  @@unique([userId, externalKey])
  @@index([userId, dueAt])
}

// Link to the user's IdeaMap account (consent flow with PKCE). The IdeaMap token only opens
// IdeaMap's TaskTimmer endpoints and is stored encrypted (lib/secretBox).
model IdeaMapConnection {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String    @unique
  accessToken     String
  ideamapUserName String?
  ideamapEmail    String?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
}
